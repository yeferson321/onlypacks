---
import IconEye from '@/icons/outline/IconEye.svg';
import IconEyeSlash from '@/icons/outline/IconEyeSlash.svg';

type HTMLInputTypeAttribute = | 'button' | 'checkbox' | 'color' | 'date' | 'datetime-local' | 'email' | 'file' | 'hidden' | 'image' | 'month' | 'number' | 'password' | 'radio' | 'range' | 'reset' | 'search' | 'submit' | 'tel' | 'text' | 'time' | 'url' | 'week';
type HTMLInputAutocompleteAttribute = | "name" | "given-name" | "family-name" | "username" | "email" | "new-password" | "current-password" | "tel" | "organization" | "street-address" | "country" | "postal-code" | "bday" | "off";

interface Props {
    type: HTMLInputTypeAttribute;
    autocomplete: HTMLInputAutocompleteAttribute;
    labelText: string;
    minLength?: number;
    maxLength?: number;
    required?: boolean;
};

const { type, autocomplete, labelText, minLength = 6, maxLength = 120, required = false } = Astro.props;
---

<div data-field-type={type} data-field-autocomplete={autocomplete}>

    <div class="relative">

        <input type={type} id={`search-${type}`} autocomplete={autocomplete} minlength={minLength} maxlength={maxLength} class="peer block w-full py-3 px-4 border rounded-2xl border-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" data-input placeholder=" " required={required} />

        <label for={`search-${type}`} class="absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-sm text-neutral-600 bg-white

            peer-placeholder-shown:top-1/2
            peer-placeholder-shown:-translate-y-1/2
            peer-placeholder-shown:text-base
            peer-placeholder-shown:text-neutral-600
            peer-placeholder-shown:bg-transparent

            peer-focus:top-0
            peer-focus:-translate-y-1/2
            peer-focus:text-sm
            peer-focus:text-blue-500
            peer-focus:bg-white">

            {labelText}
        </label>

        {type === "password" && (

            <button type="button" data-toggle-password class="absolute right-4 top-1/2 -translate-y-1/2" aria-label="Mostrar contraseña">
            
                <IconEye stroke-width="1.6" width="20" height="20" class="stroke-neutral-600 hidden" data-eye-open/>

                <IconEyeSlash stroke-width="1.6" width="20" height="20" class="stroke-neutral-600" data-eye-closed/>

            </button>

        )}

    </div>

    {type === "password" && (

        <div class="mt-2 px-4">
            <div class="w-full h-1.5 rounded-full bg-neutral-200">
                <div class="w-0 h-full rounded-full transition-all duration-300" data-password-strength-bar></div>
            </div>
        </div>

    )}

    <span class="mx-4 text-center text-sm" data-validation-message data-state="weak" aria-live="polite"></span>

</div>

<style>
[data-validation-message][data-state="weak"] {
    color: rgb(220 38 38);
}

[data-validation-message][data-state="medium"] {
    color: rgb(217 119 6);
}

[data-validation-message][data-state="strong"] {
    color: rgb(5 150 105);
}

[data-password-strength-bar][data-state="weak"] {
    width: 25%;
    background-color: rgb(220 38 38);
}

[data-password-strength-bar][data-state="medium"] {
    width: 60%;
    background-color: rgb(217 119 6);
}

[data-password-strength-bar][data-state="strong"] {
    width: 100%;
    background-color: rgb(5 150 105);
}
</style>

<script>
    import { validateName, validateUserName, validateEmail, validatePassword } from '@/components/common/utils/inputValidation';
    import { debounce } from '@/components/common/utils/limitExecution';

    const getI18n = async (locale: string) => {
      	return import(`../../i18n/${locale}.json`);
    };

    // const locale = navigator.language;
    // const locale = navigator.language.split("-")[0];
    const locale = document.documentElement.lang;
    console.log("Current locale:", locale);

    const { messages } = await getI18n(locale);

    document.querySelectorAll<HTMLDivElement>("[data-field-type]").forEach((field) => {
        const { fieldType, fieldAutocomplete, fieldRequired } = field.dataset;

        const inputElement = field.querySelector<HTMLInputElement>("[data-input]");
        const validationMessage = field.querySelector<HTMLSpanElement>("[data-validation-message]");

        if (!inputElement) return;
        if (!validationMessage) return;

        const { required, minLength, maxLength } = inputElement;

        const createDebouncedValidator = (validateFunction: Function, inputElement: HTMLInputElement, validationMessage: HTMLSpanElement, fieldKey: string, properties: any) => {
            return debounce(() => {
                const { value, validity } = inputElement;
            
                const { state, code } = validateFunction({value, validity, properties});
            
                validationMessage.dataset.state = state;
                validationMessage.textContent = code ? messages[fieldKey]?.[code] ?? "" : "";
            }, 400);
        };

        const setupPasswordToggle = (field: HTMLDivElement, inputElement: HTMLInputElement) => {
            const toggleButton = field.querySelector<HTMLButtonElement>("[data-toggle-password]");
            const eyeOpen = field.querySelector<HTMLElement>("[data-eye-open]");
            const eyeClosed = field.querySelector<HTMLElement>("[data-eye-closed]");
                
            toggleButton?.addEventListener("click", () => {
                const hidden = inputElement.type === "password";
            
                inputElement.type = hidden ? "text" : "password";
            
                eyeOpen?.classList.toggle("hidden");
                eyeClosed?.classList.toggle("hidden");
            
                toggleButton.setAttribute("aria-label", hidden ? "Ocultar contraseña" : "Mostrar contraseña");
            });
        };

        if (fieldType === "text") {
            if (fieldAutocomplete === "name") {
                inputElement.addEventListener("input", createDebouncedValidator(validateName, inputElement, validationMessage, "name", { minLength, maxLength, required }));
            }

            if (fieldAutocomplete === "username") {
                inputElement.addEventListener("input", createDebouncedValidator(validateUserName, inputElement, validationMessage, "username", { minLength, maxLength, required }));
            }
        } 
        
        if (fieldType === "email") {
            inputElement.addEventListener("input", createDebouncedValidator(validateEmail, inputElement, validationMessage, "email", { minLength, maxLength, required }));
        } 
        
        if (fieldType === "password") {
            if (fieldAutocomplete === "new-password") {
                inputElement.addEventListener("input", createDebouncedValidator(validatePassword, inputElement, validationMessage, "new-password", { minLength, maxLength, required }));

                setupPasswordToggle(field, inputElement);
            }
        }
    });
</script>