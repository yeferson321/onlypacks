---
export const prerender = false;

import ProfileLayout from '@/layouts/ProfileLayout.astro';

const pages = [
    { username: 'sofiapalmer' },
    { username: 'daniela' }
];

const { locale, username, tab } = Astro.params;

// console.log(locale, username);

const page = pages.find((page) => page.username === username);

if (!page) return Astro.redirect("/404");
---

<ProfileLayout locale={locale} username={username} tab={tab}>

</ProfileLayout>