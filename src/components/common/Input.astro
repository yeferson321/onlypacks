---
type HTMLInputTypeAttribute = | 'button' | 'checkbox' | 'color' | 'date' | 'datetime-local' | 'email' | 'file' | 'hidden' | 'image' | 'month' | 'number' | 'password' | 'radio' | 'range' | 'reset' | 'search' | 'submit' | 'tel' | 'text' | 'time' | 'url' | 'week';

interface Props {
    type: HTMLInputTypeAttribute;
    labelText: string;
};

const { type, labelText } = Astro.props;
---


<div class="relative">

    <input type={type} class="peer block w-full py-3 px-4 border rounded-2xl border-neutral-500 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" placeholder=" " required />

    <label
        for="search"
        class="absolute left-3 px-1 pointer-events-none duration-300
               top-0 -translate-y-1/2 text-sm bg-white
               peer-placeholder-shown:top-1/2
               peer-placeholder-shown:-translate-y-1/2
               peer-placeholder-shown:text-base
               peer-placeholder-shown:bg-transparent
               peer-focus:top-0
               peer-focus:-translate-y-1/2
               peer-focus:text-sm
               peer-focus:text-blue-500
               peer-focus:bg-white">
        
        {labelText}
    </label>

</div>