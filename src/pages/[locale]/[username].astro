---
export const prerender = false;

import { localeCodes, isLocale, getLocaleHref } from '@/i18n/config';
import data from '@/utils/data.json';
import ProfileLayout from '@/layouts/ProfileLayout.astro';

const { locale, username } = Astro.params;

if (!isLocale(locale)) return Astro.redirect(getLocaleHref(Astro.preferredLocale, username));

const datafetch = data.find((data) => data.username.toLocaleLowerCase() === username);

if (!datafetch) return Astro.redirect(getLocaleHref(Astro.preferredLocale));

console.log("locale > username");
---

<ProfileLayout locale={locale} username={username}/>