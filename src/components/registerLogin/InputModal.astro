<style>
:global(.form-field[data-state="invalid"]) .field-input {
    border-color: oklch(64.6% 0.222 41.116);
}

:global(.form-field[data-state="valid"]) .field-input {
    border-color: oklch(50.8% 0.118 165.612);
}



:global(.form-field[data-state="invalid"]) .field-label {
    color: oklch(64.6% 0.222 41.116);
}

:global(.form-field[data-state="valid"]) .field-label {
    color: oklch(50.8% 0.118 165.612);
}


:global(.form-field[data-state="invalid"]) .field-feedback {
    color: oklch(64.6% 0.222 41.116);
}


.field-strength-bar {
    transition: 
        width var(--transition-duration, 300ms) var(--transition-timing, ease-in-out), 
        background-color var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

:global(.form-field[data-strength="weak"]) .field-strength-bar {
    width: 25%;
    background-color: oklch(69.6% 0.17 162.48);
}

:global(.form-field[data-strength="medium"]) .field-strength-bar {
    width: 60%;
    background-color: oklch(59.6% 0.145 163.225);
}

:global(.form-field[data-strength="strong"]) .field-strength-bar {
    width: 100%;
    background-color: oklch(50.8% 0.118 165.612);
}
</style>