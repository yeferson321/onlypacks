---
import type { Translation } from '@/i18n/config';
import FormField from '@/components/common/FormField/FormField.astro';
import IconToggle from '@/components/common/IconToggle.astro';
import IconEye from '@/icons/outline/IconEye.svg';
import IconEyeSlash from '@/icons/outline/IconEyeSlash.svg';

interface Props {
	translations: Translation.RegisterForm;
};

const { translations } = Astro.props;
---

<form class="mt-6"> 

	<div class="space-y-4">

		<FormField>

            <div class="relative">
                        
                <input type="text" name="name" class="field-input peer block w-full py-3 px-4 border rounded-2xl border-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" autocomplete="name" minlength={6} maxlength={120} data-field-input placeholder=" " required={true}>

                <label class="field-label absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-sm text-neutral-600 bg-white
                    peer-placeholder-shown:top-1/2
                    peer-placeholder-shown:-translate-y-1/2
                    peer-placeholder-shown:text-base

                    peer-placeholder-shown:bg-transparent
                    peer-focus:top-0
                    peer-focus:-translate-y-1/2
                    peer-focus:text-sm
                    peer-focus:text-blue-500
                    peer-focus:bg-white">
                    {translations.fields.name.label}
                </label>
                        
            </div>
        
            <div class="field-feedback mt-0.5 mx-4 text-center text-sm" data-field-feedback aria-live="polite" data-messages={JSON.stringify(translations.fields.name.validation)}></div>
            
        </FormField>

        <FormField>

            <div class="relative">
                        
                <input type="email" name="email" class="field-input peer block w-full py-3 px-4 border rounded-2xl border-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" autocomplete="email" minlength={6} maxlength={120} data-field-input placeholder=" " required={true}>

                <label class="field-label absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-sm text-neutral-600 bg-white
                    peer-placeholder-shown:top-1/2
                    peer-placeholder-shown:-translate-y-1/2
                    peer-placeholder-shown:text-base

                    peer-placeholder-shown:bg-transparent
                    peer-focus:top-0
                    peer-focus:-translate-y-1/2
                    peer-focus:text-sm
                    peer-focus:text-blue-500
                    peer-focus:bg-white">
                    {translations.fields.email.label}
                </label>
                        
            </div>
        
            <div class="field-feedback mt-0.5 mx-4 text-center text-sm" data-field-feedback aria-live="polite" data-messages={JSON.stringify(translations.fields.name.validation)}></div>
            
        </FormField>

        <FormField>
            
            <div class="relative">

                <input type="password" name="newPassword" class="field-input peer block w-full py-3 px-4 border rounded-2xl border-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" autocomplete="new-password" minlength={8} maxlength={64} data-field-input placeholder=" " required={false}>

                <label class="field-label absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-sm text-neutral-600 bg-white
                    peer-placeholder-shown:top-1/2
                    peer-placeholder-shown:-translate-y-1/2
                    peer-placeholder-shown:text-base
                    
                    peer-placeholder-shown:bg-transparent
                    peer-focus:top-0
                    peer-focus:-translate-y-1/2
                    peer-focus:text-sm
                    peer-focus:text-blue-500
                    peer-focus:bg-white">
                    {translations.fields.newPassword.label}
                </label>

                <IconToggle class="absolute right-4 top-1/2 -translate-y-1/2" data-toggle="password" ariaLabelActive={translations.fields.newPassword.ariaLabel.hidePassword} ariaLabelInactive={translations.fields.newPassword.ariaLabel.showPassword}>

                    <IconEye stroke-width="1.6" width="20" height="20" class="stroke-neutral-600 hidden" data-icon-active/>

                    <IconEyeSlash stroke-width="1.6" width="20" height="20" class="stroke-neutral-600" data-icon-inactive/>

                </IconToggle>

            </div>

            <div class="field-feedback mt-0.5 mx-4 text-center text-sm" data-field-feedback aria-live="polite" data-messages={JSON.stringify(translations.fields.newPassword.validation)}></div>

            <div class="mt-2 mx-4">
                <div class="w-full h-1 rounded-full bg-neutral-200">
                    <div class="field-strength-bar w-1/4 h-1 rounded-full bg-emerald-500"></div>
                </div>
            </div>
            
        </FormField>

        <div class="form-feedback mt-4 text-center text-sm text-red-500 hidden" data-form-feedback aria-live="polite"></div>

		<!-- <Input type="email" autocomplete="email" labelText="Tu correo electrónico" minLength={6} maxLength={245} required={true}/>  -->  
		<!-- <Input type="password" autocomplete="new-password" labelText="Tu contraseña" required={true} errorMessages={messages.newPassword}/>  -->
	
    </div>

	<button type="submit" class="mt-6 w-full p-2 rounded-3xl text-center text-lg font-medium text-white bg-blue-500">{translations.actions.submit}</button>
        			    
</form>


<script>
    import { actions } from "astro:actions";

    type RegisterForm = {
        name: string;
        email: string;
        newPassword: string;
    };

    const form = document.querySelector('form');
    const formFeedback = form?.querySelector('[data-form-feedback]') as HTMLElement | null;

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const dataf = Object.fromEntries(formData.entries()) as RegisterForm;

        const { data, error } = await actions.register(dataf);

        if (error) {
            if (formFeedback) {
                formFeedback.textContent = error.message;
                formFeedback.classList.remove('hidden');
            }
            return;
        }
        // window.location.href = "/profile";
      
        console.log("formData", data, "result", data, error);
    })
</script>


