---
export const prerender = false;

import { getLocaleHref } from '@/i18n/config';
import ProfileLayout from '@/layouts/ProfileLayout.astro';

const { username } = Astro.params;

const respuesta = await fetch(`http://192.168.1.21:4321/api/usuarios/${username}`);

if (!respuesta.ok || respuesta.status === 404) {
    return Astro.redirect("/404");
}

const usuario = await respuesta.json();

// getLocaleHref(Astro.preferredLocale)
console.log(usuario)

// if (!usuario) return Astro.redirect("/404");

console.log("[username]")
---

<ProfileLayout data={usuario}/>