---
export const prerender = false;

// import { actions } from 'astro:actions';
import { supabase } from '@/lib/supabase';
import { resolveLocale, getI18n } from '@/i18n/config';
import ProfileLayout from '@/layouts/ProfileLayout.astro';

const { username } = Astro.params;
// const { data, error } = await Astro.callAction(actions.getUserByUsername, { username: username });

const { data, error } = await supabase.from('profiles').select(`*, social_links (*), stories (*), posts (*)`).ilike('username', username).single();

if (error) return Astro.redirect("/404");

const locale = resolveLocale(Astro.preferredLocale);

const t = await getI18n(locale);
---

<ProfileLayout translations={t} locale={locale} data={data}>

</ProfileLayout>

