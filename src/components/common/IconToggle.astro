---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<"button"> {
    ariaLabelActive: string;
    ariaLabelInactive: string;
}

const { class: className = "", ariaLabelActive, ariaLabelInactive, ...attributes } = Astro.props;
---

<button type="button" class:list={["icon-toggle", className]} data-state="inactive" data-aria-label-active={ariaLabelActive} data-aria-label-inactive={ariaLabelInactive} {...attributes} aria-label={ariaLabelInactive} aria-pressed="false">        
    <slot />
</button>

<script>
    const setupIconToggle = (buttonElement: HTMLButtonElement) => {
        const { ariaLabelActive = "", ariaLabelInactive = "" } = buttonElement.dataset;
            
        const iconOn = buttonElement.querySelector<HTMLElement>("[data-icon-active]");
        const iconOff = buttonElement.querySelector<HTMLElement>("[data-icon-inactive]");

        buttonElement.addEventListener("click", () => {
            const isActive = buttonElement.dataset.state === "active";
            const nextIsActive = !isActive;

            buttonElement.dataset.state = nextIsActive ? "active" : "inactive";
            buttonElement.setAttribute("aria-label", nextIsActive ? ariaLabelActive : ariaLabelInactive);
            buttonElement.setAttribute("aria-pressed", String(nextIsActive));

            iconOn?.classList.toggle("hidden", !nextIsActive);
            iconOff?.classList.toggle("hidden", nextIsActive);

            buttonElement.dispatchEvent(new CustomEvent("toggle:change", { detail: { active: nextIsActive }, bubbles: true }));
        });
    };

    document.querySelectorAll<HTMLButtonElement>(".icon-toggle").forEach(setupIconToggle);
</script>