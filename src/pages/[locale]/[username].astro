---
export const prerender = false;

import { actions } from 'astro:actions';
import { resolveLocale, getLocaleHref, getI18n } from '@/i18n/config';
import ProfileLayout from '@/layouts/ProfileLayout.astro';

const { locale, username } = Astro.params;

const routeLocale = resolveLocale(locale);
if (routeLocale !== locale) return Astro.redirect(getLocaleHref(routeLocale, username));

const { data, error } = await Astro.callAction(actions.getUserByUsername, { username: username });

if (error) return Astro.redirect("/404");

const t = await getI18n(locale);
---

<ProfileLayout translations={t} locale={locale} data={data}>

</ProfileLayout>

