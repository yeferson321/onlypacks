---
interface Props {
    sidebarId: string;
    className?: string;
    overlayColor?: string;
    offset?: string;
    horizontalPosition?: 'left' | 'right';
    unmount?: boolean;
};

const { sidebarId, className, overlayColor, offset, horizontalPosition = 'right', unmount = true } = Astro.props;
---
           
<div id={`sidebar-${sidebarId}`} class:list={["sidebar", className]} data-sidebar-id={sidebarId} data-state="closed" data-horizontal={horizontalPosition} data-unmount={unmount} tabindex="-1" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="sidebar-overlay" style={overlayColor && `--overlay-color: ${overlayColor};`}></div>
    <div class="sidebar-wrapper">
        <div class="sidebar-panel" style={offset && `--offset: ${offset};`}>
            <div class="sidebar-content">
                <slot/>
            </div>
        </div>
    </div>
</div>

<style>
.sidebar {
    display: none;
    position: relative;
    z-index: 40;
}

.sidebar:not([data-state="closed"]) {
    display: block;
}

.sidebar-overlay {
    position: fixed;
    inset: 0px;
    opacity: 0;
    background-color: var(--overlay-color);
    backdrop-filter: blur(1px);
    transition: opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.sidebar[data-state="open"] > .sidebar-overlay { opacity: 1; }

.sidebar-wrapper {
    pointer-events: none;
    position: fixed;
    inset: 0;
    overflow: hidden;
}

.sidebar-panel {
    position: fixed;
    inset-block: 0px;
    display: flex;
    max-width: 100%;
}

.sidebar[data-horizontal="right"] .sidebar-panel { right: 0; padding-left: var(--offset); }
.sidebar[data-horizontal="left"] .sidebar-panel { left: 0; padding-right: var(--offset); }

.sidebar-content {
    pointer-events: auto;
    display: flex;
    width: fit-content;     
    opacity: 0;
    transform: translateX(var(--translateX));
    transition: 
        opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out), 
        transform var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.sidebar[data-horizontal="left"] .sidebar-content { --translateX: -100%; }
.sidebar[data-horizontal="right"] .sidebar-content { --translateX: 100%; }

.sidebar[data-state="open"] .sidebar-content {
    opacity: 1;
    transform: translateX(0);
}
</style>

<script>
    import { appendChildElement, removeElement, trapFocus } from '@/components/common/utils/Hola';

    document.querySelectorAll<HTMLDivElement>(".sidebar").forEach((sidebarElement) => {
        const { sidebarId, unmount } = sidebarElement.dataset; 
        if (!sidebarId) throw new Error('Missing "data-sidebar-id" attribute on Sidebar component');

        unmount === "true" ? removeElement(sidebarElement) : appendChildElement(sidebarElement);

        const sidebarOverlayElement = sidebarElement.querySelector<HTMLDivElement>(".sidebar-overlay");
        if (!sidebarOverlayElement) throw new Error(`Sidebar "${sidebarId}": component internal element(s) .sidebar-overlay not found.`);

        const openButtonElement = document.querySelector<HTMLButtonElement>(`[data-sidebar-open="${sidebarId}"]`);
        const closeButtonElement = sidebarElement.querySelector<HTMLButtonElement>("[data-sidebar-close]");
        const focusableElement = sidebarElement.querySelector<HTMLElement>("[data-sidebar-autofocus]");
        let lastFocusedElement: HTMLElement | null = null;

        const setAccessibility = (isOpen: boolean) => {
            sidebarElement.dataset.state = isOpen ? "closed" : "open";
            sidebarElement.setAttribute("aria-hidden", String(isOpen));
            openButtonElement?.setAttribute("aria-expanded", String(!isOpen));
        };

        const handleKeyboard = (event: KeyboardEvent) => {
            if (event.key === "Escape") return hideSidebar();
            if (event.key === "Tab") trapFocus(sidebarElement, event);
        };

        const showSidebar = () => {
            if (sidebarElement.dataset.state !== "closed") return;
            if (unmount === "true") appendChildElement(sidebarElement);

            sidebarElement.dataset.state = "opening";

            requestAnimationFrame(() => {
                setAccessibility(false);

                sidebarElement.addEventListener("keydown", handleKeyboard); 
 
                lastFocusedElement = document.activeElement as HTMLElement;

                (focusableElement || sidebarElement)?.focus();
            });
        };

        const hideSidebar = () => {
            if (sidebarElement.dataset.state !== "open") return;

            sidebarElement.removeEventListener("keydown", handleKeyboard);

            lastFocusedElement?.focus();

            sidebarElement.dataset.state = "closing";

            sidebarOverlayElement.addEventListener("transitionend", () => {
                setAccessibility(true);
                if (unmount === "true") removeElement(sidebarElement);
            }, { once: true });
        };

        sidebarOverlayElement.addEventListener("click", hideSidebar);
        openButtonElement?.addEventListener("click", showSidebar);
        closeButtonElement?.addEventListener("click", hideSidebar);
        window.addEventListener(`sidebar:show:${sidebarId}`, showSidebar);
        window.addEventListener(`sidebar:hide:${sidebarId}`, hideSidebar);
    });
</script>